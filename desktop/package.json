{
  "name": "citadel-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --win portable --publish never",
    "package:win": "npm run package",
    "preview": "vite preview"
  },
  "build": {
    "appId": "local.citadel.desktop",
    "productName": "Citadel Desktop",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.3",
    "vite": "^6.3.5"
  }
}
